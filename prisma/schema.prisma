// 1. Configuración del Generador y la Fuente de Datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2. Modelo de Usuario 
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String // Hash del password
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Seguridad y Onboarding
  twoFactorSecret     String?
  isTwoFactorEnabled  Boolean         @default(false)
  forcePasswordChange Boolean         @default(true) // Para el flujo de onboarding
  auditLogs           AuditLog[]

  // Relaciones de Perfiles
  sellerProfile       SellerProfile?
  agentProfile        AgentProfile? // Relación con el Agente
  renterProfile       RenterProfile?
  buyerProfile        BuyerProfile? // Relación con el Comprador
  webuserProfile      WebuserProfile?

  // --- Relaciones de Mensajería Interna ---
  sentMessages        Message[]       @relation("SentMessages")
  receivedMessages    Message[]       @relation("ReceivedMessages")

  // --- Relaciones de la Comunidad ---
  communityPosts      CommunityPost[]
  postLikes           PostLike[]
  pollVotes           PollVote[]
  communityComments   CommunityComment[]

  // --- Relaciones de Cursos / Actividades ---
  activityProgress    UserProgress[]
}

model WebuserProfile {
  id String @id @default(cuid())

  // Relación con el usuario principal (Autenticación y Mensajes)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone  String?

  // Tiempos de registro
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RenterProfile {
  id String @id @default(cuid())

  // Relación con el usuario (Autenticación)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos públicos del rentero
  RenterName String? // Nombre a mostrar públicamente
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leases LeaseAgreement[]
}

// Perfil de Vendedor Actualizado (RF-04, RF-05, RF-19..21, RF-26)
model SellerProfile {
  id String @id @default(cuid())

  // Relación con el usuario (Autenticación)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos públicos del vendedor
  sellerName  String? // Nombre a mostrar públicamente
  sellerImage String? // Avatar público
  sellerType  String   @default("OWNER")
  phone       String?

  // Integración GoHighLevel (GHL) y Contratos
  ghlContactId        String?            @unique
  ghlOpportunityId    String?
  agreementType       AgreementType?
  agreementSigned     Boolean            @default(false)
  agreementSignedAt   DateTime?
  discordInviteSent   Boolean            @default(false)

  // Asistente / Transaction Coordinator (RF-20, RF-21)
  hasAssistant         Boolean            @default(false)
  assistantName        String?
  assistantEmail       String?
  assistantPhone       String?
  assistantDiscordSent Boolean            @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación 1-a-Muchos con las propiedades
  properties Property[]
}

// Perfil para Agentes que refieren clientes
model AgentProfile {
  id String @id @default(cuid())

  // Relación con el usuario (Autenticación)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos del agente
  agentName  String?
  agentPhone String?
  agentImage String?
  company    String? // Opcional, por si trabajan para una agencia

  // Notas internas sobre comisiones o acuerdos
  commissionNotes String? @db.Text

  // Balance financiero y referidos del agente
  balance   Decimal         @default(0) @db.Decimal(10, 2)
  referrals AgentReferral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentReferral {
  id String @id @default(cuid())

  // 1. Enlace con el Agente que lo refirió
  agentId String
  agent   AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // 2. Enlace con la Propiedad de interés
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 3. Datos del referido
  clientName  String
  clientPhone String?
  clientEmail String?

  // 4. Datos financieros
  expectedDeposit    Decimal? @db.Decimal(10, 2) // Ej. $10,000
  expectedCommission Decimal? @db.Decimal(10, 2) // Ej. $4,000
  balanceOwed        Decimal? @db.Decimal(10, 2) // Lo que debe pagar el agente (Depósito - Comisión)

  // 5. Estado del referido
  status ReferralStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, clientEmail, clientPhone])
}

// 3. Modelo de Propiedad Actualizado
model Property {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Gestión Interna y Estado ---
  slug           String         @unique
  status         PropertyStatus @default(DRAFT)
  isFeatured     Boolean        @default(false)
  isOffMarket    Boolean        @default(false)
  publishFeePaid Boolean        @default(false)

  // --- Control de Completitud y Autoservicio (RF-10 a RF-18, RF-28) ---
  isDraftComplete Boolean   @default(false)
  missingFields   String[]  // Lista de campos faltantes para Frank/Lucy
  publishedAt     DateTime?

  // --- Estimaciones Ligeras del Vendedor (RF-06 a RF-09) ---
  suggestedPriceMin       Float?
  suggestedPriceMax       Float?
  suggestedInterestRate   Float?  @default(10.0) // 10% base
  estimatedMonthlyPayment Float?

  // --- Datos Operativos del Vendedor (RF-10, RF-23) ---
  salePrice          Float?
  estimatedTaxes     Float?
  estimatedInsurance Float?
  previouslySold     Boolean @default(false)

  // --- Contenido Bilingüe ---
  titleEn       String
  titleEs       String
  descriptionEn String @db.Text
  descriptionEs String @db.Text

  // --- Datos Financieros (Venta Histórica/Catálogo) ---
  isForSale         Boolean   @default(true)
  price             Decimal?  @db.Decimal(10, 2)
  previousPrice     Decimal?  @db.Decimal(10, 2)
  lastPriceChangeAt DateTime?
  downPayment       Decimal?  @db.Decimal(10, 2)
  interestRate      Decimal?  @db.Decimal(5, 2)
  taxes             Decimal?  @db.Decimal(10, 2)
  insurance         Decimal?  @db.Decimal(10, 2)

  // --- Datos Financieros (Renta / Lease) ---
  isForRent       Boolean  @default(false)
  monthlyRent     Decimal? @db.Decimal(10, 2)
  securityDeposit Decimal? @db.Decimal(10, 2)

  // --- Ubicación y Contacto ---
  address      String
  city         String
  state        String
  zipCode      String
  phoneNumber  String?
  calendarLink String?

  // Campos de Ubicación y Lockbox
  latitude        Float?
  longitude       Float?
  lockboxCode     String?
  lockboxAccesses LockboxAccess[]
  availableDate   DateTime?

  // --- Especificaciones Técnicas ---
  bedrooms  Int
  bathrooms Float
  sqft      Int
  lotSize   Int?
  yearBuilt Int?

  // --- Multimedia ---
  mainImage     String
  galleryImages String[]
  videoUrl      String?         @default("")
  images        PropertyImage[]

  // --- SEO de la Página (Meta Tags) ---
  seoTitleEn       String?
  seoDescriptionEn String? @db.Text
  seoTitleEs       String?
  seoDescriptionEs String? @db.Text
  focusKeywordEn   String?
  focusKeywordEs   String?

  // --- Características Extra ---
  features String[]

  // --- Sección "Conoce a tu Vendedor" ---
  showSeller      Boolean        @default(false)
  sellerProfileId String?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)

  // Contenido para agentes
  emoji              String?
  condition          String?
  commissionPct      Decimal?            @db.Decimal(5, 2)
  commissionAmt      Decimal?            @db.Decimal(10, 2)
  commissionNote     String?             @db.Text
  showingSteps       String[]
  showingNotes       String?             @db.Text
  buyerTags          String[]
  buyerIncome        String?
  buyerCredit        String?
  buyerFinancing     String?
  marketingMaterials MarketingMaterial[]
  contracts          Contract[]
  leases             LeaseAgreement[]

  // Referidos creados por agentes
  agentReferrals AgentReferral[]
}

model MarketingMaterial {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  body       String   @db.Text
  script     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 4. Modelo de Blog Post
model Post {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug        String  @unique
  isPublished Boolean @default(false)

  titleEn   String
  titleEs   String
  contentEn String @db.Text
  contentEs String @db.Text

  mainImage String?

  postImages PostImage[]

  authorName  String?
  authorImage String?
  authorBioEn String? @db.Text
  authorBioEs String? @db.Text

  seoTitleEn     String?
  seoDescEn      String?
  focusKeywordEn String?

  seoTitleEs     String?
  seoDescEs      String?
  focusKeywordEs String?
  isCaseStudy    Boolean @default(false)
}

model PostImage {
  id      String  @id @default(cuid())
  url     String
  altText String?

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// Auditoría Centralizada
model AuditLog {
  id String @id @default(cuid())

  action     String
  entityType String?
  entityId   String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contactPhone String?
  contactName  String?

  propertyId String?
  address    String?
  details    String? @db.Text

  createdAt DateTime @default(now())
}

model SelectionSession {
  id           String   @id @default(cuid())
  token        String   @unique
  contactPhone String
  contactName  String?
  expiresAt    DateTime
  isUsed       Boolean  @default(false)

  createdAt DateTime @default(now())
}

model LockboxAccess {
  id           String   @id @default(cuid())
  token        String   @unique
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contactName  String?
  contactPhone String?
  expiresAt    DateTime
  isUsed       Boolean  @default(false)

  createdAt DateTime @default(now())
}

model PropertyImage {
  id          String   @id @default(cuid())
  url         String
  altText     String?
  title       String?
  caption     String?
  description String?
  order       Int      @default(0)
  isMain      Boolean  @default(false)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model BuyerProfile {
  id               String     @id @default(cuid())
  userId           String?    @unique
  user             User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  stripeCustomerID String?    @unique
  contracts        Contract[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Contract {
  id             String         @id @default(cuid())
  propertyId     String
  property       Property       @relation(fields: [propertyId], references: [id])
  buyers         BuyerProfile[]
  type           ContractType   @default(LOAN)
  totalAmount    Decimal        @db.Decimal(12, 2)
  downPayment    Decimal        @db.Decimal(12, 2)
  principalAmount Decimal       @db.Decimal(12, 2)
  interestRate   Decimal?       @db.Decimal(5, 2)
  termInYears    Int?
  startDate      DateTime

  monthlyTaxes     Decimal? @db.Decimal(10, 2)
  monthlyInsurance Decimal? @db.Decimal(10, 2)
  monthlyServFee   Decimal? @db.Decimal(10, 2)

  isActive Boolean   @default(true)
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaseAgreement {
  id              String          @id @default(cuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  renters         RenterProfile[]
  startDate       DateTime
  endDate         DateTime?
  monthlyRent     Decimal         @db.Decimal(10, 2)
  securityDeposit Decimal?        @db.Decimal(10, 2)
  isActive        Boolean         @default(true)
  payments        RentalPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Payment {
  id                    String        @id @default(cuid())
  contractId            String
  contract              Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  paymentDate           DateTime
  totalDue              Decimal       @db.Decimal(10, 2)
  principal             Decimal       @db.Decimal(10, 2)
  interest              Decimal       @db.Decimal(10, 2)
  taxes                 Decimal?      @db.Decimal(10, 2)
  insurance             Decimal?      @db.Decimal(10, 2)
  serviceFee            Decimal?      @db.Decimal(10, 2)
  lateFee               Decimal?      @default(0) @db.Decimal(10, 2)
  remainingBalance      Decimal       @db.Decimal(12, 2)
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  stripePaymentIntentID String?       @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RentalPayment {
  id                    String        @id @default(cuid())
  leaseId               String
  lease                 LeaseAgreement @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  paymentDate           DateTime
  totalDue              Decimal       @db.Decimal(10, 2)
  serviceFee            Decimal?      @db.Decimal(10, 2)
  lateFee               Decimal?      @default(0) @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  stripePaymentIntentID String?       @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?    @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([recipientId, isRead])
  @@index([senderId])
}

model CommunityPost {
  id        String             @id @default(cuid())
  text      String?            @db.Text
  imageUrl  String?
  videoUrl  String?
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  options   PollOption[]
  pollVotes PollVote[]
  comments  CommunityComment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model PostLike {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
}

model PollOption {
  id     String        @id @default(cuid())
  text   String
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id        String        @id @default(cuid())
  optionId  String
  option    PollOption    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
}

model CommunityComment {
  id        String        @id @default(cuid())
  text      String        @db.Text
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderHierarchy")
  files     MediaFile[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MediaFile {
  id        String       @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

model Course {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  isPublished Boolean        @default(false)
  nodes       ActivityNode[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ActivityNode {
  id          String         @id @default(cuid())
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  orderIndex  Float
  payload     NodePayload?
  completions UserProgress[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([courseId, orderIndex])
}

model NodePayload {
  id        String         @id @default(cuid())
  nodeId    String         @unique
  node      ActivityNode   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  mediaUrl  String?
  mediaType String?
  questions QuizQuestion[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model QuizQuestion {
  id        String       @id @default(cuid())
  payloadId String
  payload   NodePayload  @relation(fields: [payloadId], references: [id], onDelete: Cascade)
  text      String       @db.Text
  options   QuizOption[]
  createdAt DateTime     @default(now())
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  createdAt  DateTime     @default(now())
}

model UserProgress {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String
  node        ActivityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  score       Float?
  completedAt DateTime     @default(now())

  @@unique([userId, nodeId])
}

// --- Enums ---
enum Role {
  ADMIN
  STAFF
  USER
}

enum PropertyStatus {
  DRAFT
  PENDING_DOCUMENTATION
  AVAILABLE
  UNDER_CONTRACT
  SOLD
  RENTED
  COMING_SOON
}

// Nuevo Enum para Acuerdos de Comisión (RF-05)
enum AgreementType {
  FLAT_10K
  PERCENT_5
}

enum ReferralStatus {
  PENDING
  WON
  LOST
}

enum ContractType {
  LOAN
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  PARTIAL
}