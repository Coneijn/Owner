// 1. Configuración del Generador y la Fuente de Datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 2. Modelo de Usuario 
model User {
  id                 String   @id @default(cuid())
  name               String?
  email              String   @unique
  password           String // Hash del password
  role               Role     @default(ADMIN)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  twoFactorSecret    String? // El secreto generado por otplib
  isTwoFactorEnabled Boolean  @default(false)
  sellerProfile      SellerProfile?
}

model SellerProfile {
  id          String   @id @default(cuid())
  
  // Relación con el usuario (Autenticación)
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos públicos del vendedor
  sellerName  String?  // Nombre a mostrar públicamente
  sellerImage String?  // Avatar público
  sellerType  String   @default("OWNER")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación 1-a-Muchos con las propiedades
  properties  Property[]
}

// 3. Modelo de Propiedad 
model Property {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Gestión Interna y Estado ---
  slug        String         @unique
  status      PropertyStatus @default(AVAILABLE)
  isFeatured  Boolean        @default(false)
  // Para ocultar propiedades del catálogo público
  isOffMarket Boolean        @default(false)

  // --- Contenido Bilingüe ---
  // Títulos
  titleEn       String
  titleEs       String
  // Descripciones 
  descriptionEn String @db.Text
  descriptionEs String @db.Text

  // --- Datos Financieros (Venta) ---
  isForSale    Boolean @default(true)
  price        Decimal? @db.Decimal(10, 2) 

  previousPrice Decimal? @db.Decimal(10, 2)
  lastPriceChangeAt DateTime?

  downPayment  Decimal? @db.Decimal(10, 2) 
  interestRate Decimal? @db.Decimal(5, 2) 
  taxes        Decimal? @db.Decimal(10, 2) 
  insurance    Decimal? @db.Decimal(10, 2)

  // --- Datos Financieros (Renta / Lease) [NUEVO] ---
  isForRent       Boolean  @default(false)
  monthlyRent     Decimal? @db.Decimal(10, 2)
  securityDeposit Decimal? @db.Decimal(10, 2)

  // --- Ubicación y Contacto ---
  address      String
  city         String
  state        String
  zipCode      String
  phoneNumber  String?
  calendarLink String?
  
  // CAMPOS DE UBICACIÓN 
  latitude      Float?
  longitude     Float?
  lockboxCode   String?
  availableDate DateTime?

  // --- Especificaciones Técnicas ---
  bedrooms  Int
  bathrooms Float
  sqft      Int
  lotSize   Int?
  yearBuilt Int?

  // --- Multimedia ---
  mainImage     String
  galleryImages String[]
  videoUrl      String?         @default("")
  images        PropertyImage[]

  // --- SEO de la Página (Meta Tags) ---
  seoTitleEn       String?
  seoDescriptionEn String? @db.Text
  seoTitleEs       String?
  seoDescriptionEs String? @db.Text

  // --- Características Extra ---
  features String[]

  // --- Sección "Conoce a tu Vendedor" ---
  showSeller  Boolean @default(false)
  sellerProfileId String?
  sellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
}

// 4. Modelo de Blog Post (Actualizado)
model Post {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slug        String   @unique
  isPublished Boolean  @default(false)

  // Contenido Bilingüe
  titleEn   String
  titleEs   String
  contentEn String @db.Text // Puede ser Markdown o HTML
  contentEs String @db.Text

  // Multimedia Principal
  mainImage String?

  // --- Imágenes Inline del Post [NUEVO] ---
  postImages PostImage[]

  // --- Sección de Autor / Bio por Post [NUEVO] ---
  authorName  String?
  authorImage String?
  authorBioEn String? @db.Text
  authorBioEs String? @db.Text

  // --- SEO Avanzado [ACTUALIZADO] ---
  seoTitleEn     String?
  seoDescEn      String?
  focusKeywordEn String? // Keyword principal EN

  seoTitleEs     String?
  seoDescEs      String?
  focusKeywordEs String? // Keyword principal ES
}

// 5. Modelo de Imágenes para el Blog [NUEVO]
model PostImage {
  id      String  @id @default(cuid())
  url     String
  altText String?

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// 6. Modelo de Imágenes de Propiedades (Existente)
model PropertyImage {
  id  String @id @default(cuid())
  url String

  // Metadatos
  altText     String?
  title       String?
  caption     String?
  description String?

  // Orden y Tipo
  order  Int     @default(0)
  isMain Boolean @default(false) // Para identificar la principal

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// 7. Enums
enum Role {
  ADMIN
  STAFF
  USER
}

enum PropertyStatus {
  AVAILABLE
  UNDER_CONTRACT
  SOLD
  DRAFT
  COMING_SOON
}